/* Black Week */

.nav__wrapper.navbar ul li.megamenu__item:first-child a {
    color: red;
    font-size: 1.5rem;
}
[data-scrolldir=down] .header--fixed .header-wrapper  {
  top: -82px;
}
@media (min-width: 768px) {
  [data-scrolldir=down] .header--fixed .header-wrapper  {
    top: -32px;
  }
}
