 text-decoration:underline;
 padding:1.6rem;
 display:inline-block;
 white-space:nowrap
}
.user-login__cta--pipe {
 position:relative;
 padding-right:0rem;
 margin-right:0rem
}
.user-login__cta--pipe:after {
 content:'';
 position:absolute;
 height:20px;
 width:1px;
 background:#979797;
 top:0;
 bottom:0;
 right:0;
 margin:auto 0
}
.user-login__cta--block {
 width:100% !important;
 padding:.8rem 1.6rem;
 text-decoration:none
 display: block !important;
}
