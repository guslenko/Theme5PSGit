@font-face {
  font-family: 'Rajdhani';
  font-style: normal;
  font-weight: 300;
  src:  url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-300.woff2') format('woff2'),
        url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-300.woff') format('woff');
  font-display: swap;
}
@font-face {
  font-family: 'Rajdhani';
  font-style: normal;
  font-weight: 400;
  src:  url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-regular.woff2') format('woff2'),
        url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-regular.woff') format('woff');
  font-display: swap;
}
@font-face {
  font-family: 'Rajdhani';
  font-style: normal;
  font-weight: 500;
  src:  url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-500.woff2') format('woff2'),
        url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-500.woff') format('woff');
  font-display: swap;
}
@font-face {
  font-family: 'Rajdhani';
  font-style: normal;
  font-weight: 600;
  src:  url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-600.woff2') format('woff2'),
        url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-600.woff') format('woff');
  font-display: swap;
}
@font-face {
  font-family: 'Rajdhani';
  font-style: normal;
  font-weight: 700;
  src:  url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-700.woff2') format('woff2'),
        url('https://cdn02.plentymarkets.com/4in9ikd3ipve/frontend/ps2k19/fonts/rajdhani-v7-latin-700.woff') format('woff');
  font-display: swap;
}

:root {
  --primary-color: #bace0d;
  --secondary-color: #4B4A4B;
  --global-text: #444939;
  --background-color: #ffffff;
  --background-menu-first: rgb(186, 206, 13);
  --background-menu-second: rgb(186, 206, 13);
  --menu-text-color: #ffffff;
  --menu-hover-color: #ff9900;
  --link-color: #444939;
  --link-hover-color: #444939;
  --availability_1-color: #28a745;
  --availability_2-color: #dc3545;
  --availability_3-color: #ff9900;
  --availability_4-color: #ff9900;
  --availability_5-color: #ff9900;
  --availability_6-color: #dc3545;
  --availability_7-color: #dc3545;
  --availability_8-color: #dc3545;
  --availability_9-color: #dc3545;
  --availability_10-color: #dc3545;
}

/* Bootstrap erweiterung start */
.col-xxl-1, .col-xxl-2, .col-xxl-3, .col-xxl-4, .col-xxl-5, .col-xxl-6, .col-xxl-7, .col-xxl-8, .col-xxl-9, .col-xxl-10, .col-xxl-11, .col-xxl-12, .col-xxl,
.col-xxl-auto, .col-xxxl-1, .col-xxxl-2, .col-xxxl-3, .col-xxxl-4, .col-xxxl-5, .col-xxxl-6, .col-xxxl-7, .col-xxxl-8, .col-xxxl-9, .col-xxxl-10, .col-xxxl-11, .col-xxxl-12, .col-xxxl,
.col-xxxl-auto {
  position: relative;
  width: 100%;
  padding-right: 15px;
  padding-left: 15px;
}
/* Bootstrap erweiterung end */

body {
    /* background: url(https://www.pentagonsports.de/layout/dblayout01/images/background2k17V1.jpg) top center transparent fixed; */
    background: #fff;

}
body > #vue-app {
    background-color: transparent;
    margin-top: 0px !important;
}
.shipping-profil-web {
  display: none;
}
a {
    color: #BACE0D;
}
h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
    margin-bottom: 0;
}
