    top: 0 !important;
}
.dropdown__wrapper .dropdown::after {
    content: '';
    position: absolute;
    height: .1rem;
    background: #369790;
    bottom: -.7rem;
    left: 0;
    width: 0;
    background: transparent;
    -webkit-transition: all .2s ease;
