{% macro get_nav_bar(breadcrumbs, categories, currentScopeUrl, megaMenuLevels, maxItemsPerStage) %}
    {% import _self as navbar %}
    {% set counter = 0 %}
    {% set megaMenuLevels = megaMenuLevels | default(1) %}
    {% for category in categories %}
        {% if category.details | length > 0 %}
            {% if urls.includeLanguage %}
                {% set currentScopeUrl = "/" ~ category.details[0].lang ~  "/" ~ category.details[0].nameUrl %}
            {% else %}
                {% set currentScopeUrl = "/" ~ category.details[0].nameUrl %}
            {% endif %}
            {% set translatedChildren = 0 %}
            {% for children in category.children if children.details[0] %}
                {% set translatedChildren = translatedChildren + 1 %}
            {% endfor %}
            {% if category.children and translatedChildren > 0 %}
                <li role="menuitem" data-sub-menu-id="id--megamenu__sub-dropdown{{ counter }}" class="megamenu__item PentagonsportsCupcake{% for breadcrumb in breadcrumbs %}{% if category.id == breadcrumb.id %} active{% endif %}{% endfor %}">
                  <a href="{{ currentScopeUrl }}{{ urls.trailingSlashSuffix }}" title="{{ category.details[0].name }}" itemprop="url" class="megamenu__link PentagonsportsCupcake{% for breadcrumb in breadcrumbs %}{% if category.id == breadcrumb.id %} active{% endif %}{% endfor %}" data-category-id="{{ category.details[0].id }}" data-category-type="content">
                    {{ category.details[0].name }}</a>
                </li>
                <li id="id--megamenu__sub-dropdown{{ counter }}" class="megamenu__sub-menu megamenu__sub-menu--hidden">
                      <ul class="megamenu__sub-container navDropdown{{ counter }}" data-level="1">
                        <li class="megamenu__sub-wrap"><!-- span class="megamenu__sub-name">{{ category.details[0].name }}</span -->
                          <ul class="megamenu__sub-list PentagonsportsCupcake">
                        {% if megaMenuLevels == 1 %}
                            {% for child in category.children %}
                                {% if child.details | length > 0 %}
                                    <li class="megamenu__sub-item levelSub{{megaMenuLevels}}">
                                      <a href="{{ currentScopeUrl }}/{{ child.details[0].nameUrl }}{{ urls.trailingSlashSuffix }}" data-category-id="{{ category.details[0].id }}" data-category-type="item" class="PentagonsportsCupcake">
                                      {{ child.details[0].name }}
                                    </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            {{ navbar.get_childrenOrig(category, currentScopeUrl, 1, megaMenuLevels, maxItemsPerStage) }}
                        {% endif %}
                    </ul>
              </li>
            </ul>
      </li>
            {% else %}
                <li role="menuitem" data-sub-menu-id="id--megamenu__sub-dropdown{{ counter }}" class="megamenu__item PentagonsportsCupcake{% for breadcrumb in breadcrumbs %}{% if category.id == breadcrumb.id %} active{% endif %}{% endfor %}">
                    <a href="{{ currentScopeUrl }}{{ urls.trailingSlashSuffix }}" class="{% for breadcrumb in breadcrumbs %}{% if category.id == breadcrumb.id %}active{% endif %}{% endfor %}">{{ category.details[0].name }}</a>
                </li>
            {% endif %}
        {% endif %}
        {% set counter = counter + 1 %}
    {% endfor %}
{% endmacro %}


{% macro get_sidemenu(breadcrumbs, categories, currentScopeUrl, count) %}
    {% import _self as sidemenu %}
    {% set urlNow = currentScopeUrl %}
    {% for category in categories %}
        {% set urlNow =  currentScopeUrl ~ "/" ~ category.details[0].nameUrl %}
        {% if category.details[0] %}
            <div class="level{{count}}{% if category.children is not empty %} parent{% endif %}{% for breadcrumb in breadcrumbs %}{% if category.id == breadcrumb.id %} active{% endif %}{% endfor %}">
                <div class="nav-item{% for breadcrumb in breadcrumbs %}{% if category.id == breadcrumb.id %} active{% endif %}{% endfor %}">
                  {{ category.details[0].name }}</div>
                    {% if category.children is not empty %}
                        {{ sidemenu.get_sidemnuSecond(breadcrumbs, category.children, urlNow, count + 1) }}
                    {% endif %}
                  </div>
        {% endif %}
    {% endfor %}
{% endmacro %}


{% macro get_sidemnuSecond(breadcrumbs, categories, currentScopeUrl, count) %}
    {% import _self as sidemenu %}
    {% set urlNow = currentScopeUrl %}
    {% for category in categories %}
        {% set urlNow =  currentScopeUrl ~ "/" ~ category.details[0].nameUrl %}
        {% if category.details[0] %}
            <ul class="level{{count}}{% if category.children is not empty %} parent{% endif %}{% for breadcrumb in breadcrumbs %}{% if category.id == breadcrumb.id %} active{% endif %}{% endfor %}">
                <li class="detailId{{ category.details[0].id }} nav-item{% for breadcrumb in breadcrumbs %}{% if category.id == breadcrumb.id %} active{% endif %}{% endfor %}">
                    <a href="/{{ urlNow }}{{ urls.trailingSlashSuffix }}" class="nav-link{% for breadcrumb in breadcrumbs %}{% if category.id == breadcrumb.id %} active{% endif %}{% endfor %}">{{ category.details[0].name }}</a>
                    {% if category.children is not empty %}
                        {{ sidemenu.get_sidemnuSecond(breadcrumbs, category.children, urlNow, count + 1) }}
                    {% endif %}
                </li>
            </ul>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% macro get_sidemenuOld(breadcrumbs, categories, currentScopeUrl) %}

    {% import _self as sidemenu %}
    {% for category in categories if category.details[0] %}

        {% set currentUrl = currentScopeUrl %}
        {% if currentUrl is empty and urls.includeLanguage %}
            {% set currentUrl = "/" ~ category.details[0].lang %}
        {% endif %}

        {% set currentUrl = currentUrl ~ "/" ~ category.details[0].nameUrl  %}
        <ul>
            <li class="nav-item{% for breadcrumb in breadcrumbs if category.id == breadcrumb.id %} active{% endfor %}">
                <a href="{{ currentUrl }}{{ urls.trailingSlashSuffix }}" class="nav-link">{{ category.details[0].name }}</a>
                {% if category.children is not empty %}
                    {% for breadcrumb in breadcrumbs if category.id == breadcrumb.id %}
                        {{ sidemenu.get_sidemenu(breadcrumbs, category.children, currentUrl) }}
                    {% endfor %}
                {% endif %}
            </li>
        </ul>

    {% endfor %}

{% endmacro %}
