	{% if ceresConfig.log.performanceLevel  == 'development' %}
	<script>
	console.log("%c---- START SHOP DATA ---","color:blue")
	console.log("%cORDER-DATA","color:blue",{{ data | json_encode | raw }});
	console.log("%cBASKET-DATA","color:blue", {{ services.basket.getBasket() | json_encode | raw }});
	console.log("%cBASKET-Items","color:blue", {{ services.basket.getBasketItems() | json_encode | raw }});
	console.log("%cCHECKOUT-DATA","color:blue", {{ services.checkout.getCheckout() | json_encode | raw }});
	console.log("%cCATEGORY-DATA","color:blue", {{ services.category.getCurrentCategory() | json_encode | raw }});
	console.log("%cITEM-DATA", "color:blue",{{ item.documents[0].data | json_encode | raw }});
	console.log("%cITEM-LIST-DATA","color:blue", {{ itemList | json_encode | raw }});
	console.log("%cCUSTOMER-DATA","color:blue", {{services.customer.getContact() | json_encode | raw}});
	console.log("%cTEMPLATE","color:blue", {{services.template.getCurrentTemplate() | json_encode | raw}});
	console.log("%c---- END SHOP DATA ---","color:blue");
	</script>
	{% endif %}

{% endif %}
