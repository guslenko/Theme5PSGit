          <div class="easter drag easter02"><a class="easter-link" title="5%" href="https://www.pentagonsports.de/rabattcodes/6487s5">&nbsp;</a></div>
          {% endif %}
          {% if (category.id == 34 or category.id == 55 or category.id == 50 or category.id == 59 or category.id == 37 or category.id == 58) %}
          {# 10% #}
