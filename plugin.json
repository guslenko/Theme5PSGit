{
    "version"           : "5.0.89",
    "name"                  :"Theme5PSGit",
    "description"           :"Work in vue components",
    "namespace"             :"Theme5PSGit",
    "author"                :"Daniel B.",
    "keywords"              : ["theme", "Ceres5", "template"],
    "type"                  :"theme",
    "require"           : {
        "IO": "~5.0.00"
    },
    "platform"          : {
        "php": ">=7.3 <8.1"
    },
    "serviceProvider"       :"Theme5PSGit\\Providers\\Theme5PSGitServiceProvider",
    "dataProviders"     :
    [
        {
            "key"           :"Theme5PSGit\\Containers\\Theme5PSGitStyleContainer",
            "name"          :"Stylesheet",
            "description"   :"Add changes to the CSS file",
            "defaultLayoutContainer": "Ceres::Template.Style"
        },
        {
            "key"           :"Theme5PSGit\\Containers\\Theme5PSGitScriptContainer",
            "name"          :"Script",
            "description"   :"Add Script File",
            "defaultLayoutContainer": "Ceres::Script.AfterScriptsLoaded"
        },
        {
            "key"           :"Theme5PSGit\\Containers\\Theme5PSGitCategoryItem",
            "name"          :"Container for CategoryItem Component Template",
            "description"   :"Container for CategoryItem Component Template",
            "defaultLayoutContainer": "Ceres::Script.AfterScriptsLoaded"
        },
        {
            "key"           : "Search.SearchBar",
            "name"          : "Search: Override the search bar",
            "description"   : "Override the search bar in the header."
        }
    ]
}
